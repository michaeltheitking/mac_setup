# One key per machine, not one per destination — see
# docs/decisions/0002-single-ssh-key-per-machine.md
Host github.com
  HostName ssh.github.com
  Port 443
  User git
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host devbox
    HostName 100.75.124.33
    User michael
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color

Host devbox-magicdns
    HostName michaels-mac-mini.tail367472.ts.net
    User michael
