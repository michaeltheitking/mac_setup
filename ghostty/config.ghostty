theme = Catppuccin Mocha

# typography
# Nerd Font variant: supplies the glyphs LazyVim and powerlevel10k render.
# "Mono" cut keeps every glyph on the same advance width so cells stay aligned.
font-family=JetBrainsMono Nerd Font Mono
font-size=14
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1
